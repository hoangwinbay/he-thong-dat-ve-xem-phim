@model IEnumerable<GiaoDienKhachHang.Models.Phim>
@{
    ViewData["Title"] = "Danh sách phim";
    var theLoais = ViewBag.TheLoais as List<GiaoDienKhachHang.Models.TheLoai> ?? new List<GiaoDienKhachHang.Models.TheLoai>();
    string? selectedTrangThai = ViewBag.SelectedTrangThai as string;
    int? selectedTheLoai = ViewBag.SelectedTheLoai as int?;
    string? search = ViewBag.Search as string;
}

<div class="container mt-4">
    <!-- Header & Bộ lọc -->
    <div class="card bg-card border-secondary p-3 mb-4 rounded-3">
        <form method="get" asp-action="DanhSach" class="row g-3 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Trạng thái phim</label>
                <select name="trangThai" class="form-select form-select-sm bg-dark text-light border-secondary" onchange="this.form.submit()">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="DangChieu" selected="@(selectedTrangThai == "DangChieu")">Phim đang chiếu</option>
                    <option value="SapChieu" selected="@(selectedTrangThai == "SapChieu")">Phim sắp chiếu</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Thể loại</label>
                <select name="theLoaiId" class="form-select form-select-sm bg-dark text-light border-secondary" onchange="this.form.submit()">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var tl in theLoais)
                    {
                        <option value="@tl.MaTheLoai" selected="@(selectedTheLoai == tl.MaTheLoai)">@tl.TenTheLoai</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Từ khóa tìm kiếm</label>
                <input type="text" name="search" class="form-select form-select-sm bg-dark text-light border-secondary" placeholder="Tên phim, diễn viên..." value="@search" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-cinema btn-sm w-100">
                    <i class="bi bi-funnel-fill me-1"></i>Lọc
                </button>
                <a asp-action="DanhSach" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Kết quả -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-white fw-bold mb-0">
            @if (selectedTrangThai == "DangChieu") { <span>Phim Đang Chiếu</span> }
            else if (selectedTrangThai == "SapChieu") { <span>Phim Sắp Chiếu</span> }
            else { <span>Tất Cả Phim</span> }
            <span class="fs-6 fw-normal text-muted ms-2">(@Model.Count() bộ phim)</span>
        </h4>
    </div>

    <div class="row g-4 mb-5">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                <p class="text-muted">Không tìm thấy bộ phim nào phù hợp với điều kiện tìm kiếm.</p>
                <a asp-action="DanhSach" class="btn btn-outline-cinema btn-sm">Xem tất cả phim</a>
            </div>
        }
        else
        {
            @foreach (var phim in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                    <div class="card card-custom h-100">
                        <div class="poster-wrapper">
                            @if (!string.IsNullOrEmpty(phim.Poster))
                            {
                                <img src="@phim.Poster" alt="@phim.TenPhim" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(phim.DoTuoi))
                            {
                                <span class="badge badge-age @(phim.DoTuoi.Contains("18") ? "bg-danger" : phim.DoTuoi.Contains("16") ? "bg-warning text-dark" : "bg-success")">
                                    @phim.DoTuoi
                                </span>
                            }
                            <span class="badge badge-rating">
                                <i class="bi bi-star-fill me-1"></i>4.8
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-white mb-1 text-truncate" title="@phim.TenPhim">
                                @phim.TenPhim
                            </h6>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-clock me-1"></i>@phim.ThoiLuong phút
                                @if (phim.PhimTheLoais.Any())
                                {
                                    <span class="mx-1">•</span>
                                    <span>@string.Join(", ", phim.PhimTheLoais.Select(t => t.TheLoai?.TenTheLoai).Where(t => t != null).Take(2))</span>
                                }
                            </div>
                            <div class="small text-secondary mb-3 text-truncate">
                                <i class="bi bi-person-video me-1"></i>Đạo diễn: @(phim.DaoDien ?? "Đang cập nhật")
                            </div>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="ChiTiet" asp-route-id="@phim.MaPhim" class="btn btn-outline-secondary btn-sm flex-fill">
                                    Chi tiết
                                </a>
                                @if (phim.TrangThai == "DangChieu")
                                {
                                    <a asp-controller="DatVe" asp-action="ChonSuatChieu" asp-route-maPhim="@phim.MaPhim" class="btn btn-cinema btn-sm flex-fill">
                                        <i class="bi bi-ticket-perforated me-1"></i>Đặt vé
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm flex-fill" disabled>
                                        Sắp chiếu
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

