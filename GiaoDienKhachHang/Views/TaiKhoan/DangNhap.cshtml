@{
    ViewData["Title"] = "Đăng nhập tài khoản";
    string? returnUrl = ViewBag.ReturnUrl as string;
    string? error = ViewBag.Error as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-card border-secondary rounded-4 p-4 shadow-lg">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-danger fs-1"></i>
                    <h3 class="text-white fw-bold mt-2">Đăng Nhập</h3>
                    <p class="text-muted small">Đăng nhập tài khoản để đặt vé và nhận ưu đãi độc quyền</p>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small border-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                    </div>
                }

                <form asp-action="DangNhap" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="mb-3">
                        <label class="form-label text-light small">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" class="form-control bg-dark border-secondary text-light" placeholder="vidu@cinebooking.vn" required autofocus />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light small">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                            <input type="password" name="matKhau" class="form-control bg-dark border-secondary text-light" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-cinema w-100 py-2 fw-bold mb-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập
                    </button>

                    <div class="text-center text-muted small">
                        Chưa có tài khoản?
                        <a asp-action="DangKy" class="text-danger fw-bold text-decoration-none">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

