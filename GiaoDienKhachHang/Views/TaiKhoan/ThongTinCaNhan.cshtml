@model GiaoDienKhachHang.Models.NguoiDung
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card bg-card border-secondary rounded-4 p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-person-circle text-danger" style="font-size: 5rem;"></i>
                </div>
                <h4 class="text-white fw-bold mb-1">@Model.HoTen</h4>
                <p class="text-muted small mb-3">@Model.Email</p>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-danger">@Model.VaiTro</span>
                    <span class="badge bg-success">Đang hoạt động</span>
                </div>
                <p class="small text-muted mb-0">Thành viên từ: @Model.NgayTao.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card bg-card border-secondary rounded-4 p-4 mb-4">
                <h5 class="text-white fw-bold mb-4 border-bottom border-secondary pb-2">
                    <i class="bi bi-pencil-square text-warning me-2"></i>Cập nhật thông tin
                </h5>
                <form asp-action="CapNhatThongTin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-light small">Họ và tên</label>
                            <input type="text" name="hoTen" class="form-control bg-dark border-secondary text-light" value="@Model.HoTen" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light small">Địa chỉ Email (Không thay đổi)</label>
                            <input type="email" class="form-control bg-dark border-secondary text-muted" value="@Model.Email" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light small">Số điện thoại</label>
                            <input type="tel" name="soDienThoai" class="form-control bg-dark border-secondary text-light" value="@Model.SoDienThoai" />
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-cinema">
                                <i class="bi bi-check-lg me-1"></i>Lưu thông tin
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card bg-card border-secondary rounded-4 p-4">
                <h5 class="text-white fw-bold mb-4 border-bottom border-secondary pb-2">
                    <i class="bi bi-shield-lock text-info me-2"></i>Đổi mật khẩu
                </h5>
                <form asp-action="DoiMatKhau" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label text-light small">Mật khẩu hiện tại</label>
                            <input type="password" name="matKhauCu" class="form-control bg-dark border-secondary text-light" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-light small">Mật khẩu mới</label>
                            <input type="password" name="matKhauMoi" class="form-control bg-dark border-secondary text-light" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-light small">Xác nhận mật khẩu mới</label>
                            <input type="password" name="xacNhanMatKhau" class="form-control bg-dark border-secondary text-light" required />
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-outline-warning">
                                <i class="bi bi-key-fill me-1"></i>Cập nhật mật khẩu
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

