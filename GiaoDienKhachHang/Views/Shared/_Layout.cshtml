@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var maNguoiDung = HttpContextAccessor.HttpContext?.Session.GetInt32("MaNguoiDung");
    var hoTen = HttpContextAccessor.HttpContext?.Session.GetString("HoTen");
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Booking - Đặt Vé Xem Phim Trực Tuyến</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --bg-dark: #0b0f19;
            --bg-card: #151c2c;
            --bg-hover: #1e293b;
            --accent-red: #e11d48;
            --accent-gold: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: rgba(11, 15, 25, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #1e293b;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: 0.5px;
            color: #fff !important;
        }

        .navbar-brand span {
            color: var(--accent-red);
        }

        .nav-link {
            color: #cbd5e1 !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff !important;
            text-shadow: 0 0 10px rgba(225, 29, 72, 0.5);
        }

        .card-custom {
            background-color: var(--bg-card);
            border: 1px solid #1e293b;
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .card-custom:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.4);
            border-color: #334155;
        }

        .poster-wrapper {
            position: relative;
            padding-top: 145%;
            overflow: hidden;
            background: #1e293b;
        }

        .poster-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .card-custom:hover .poster-wrapper img {
            transform: scale(1.05);
        }

        .badge-age {
            position: absolute;
            top: 12px;
            left: 12px;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 4px 8px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
        }

        .badge-rating {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(0,0,0,0.75);
            color: var(--accent-gold);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .btn-cinema {
            background-color: var(--accent-red);
            border-color: var(--accent-red);
            color: white;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 18px;
            transition: all 0.2s ease;
        }

        .btn-cinema:hover {
            background-color: #be123c;
            border-color: #be123c;
            color: white;
            box-shadow: 0 4px 14px rgba(225, 29, 72, 0.4);
        }

        .btn-outline-cinema {
            border-color: #334155;
            color: #e2e8f0;
            border-radius: 8px;
        }

        .btn-outline-cinema:hover {
            background-color: #1e293b;
            color: white;
            border-color: #475569;
        }

        .footer-custom {
            margin-top: auto;
            background-color: #080b12;
            border-top: 1px solid #1e293b;
            color: var(--text-muted);
            padding: 40px 0 20px;
        }

        .footer-custom a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-custom a:hover {
            color: #fff;
        }

        /* Ghế rạp chiếu */
        .seat-item {
            width: 36px;
            height: 34px;
            margin: 4px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
        }

        .seat-thuong {
            background: #334155;
            color: #cbd5e1;
            border: 1px solid #475569;
        }

        .seat-vip {
            background: #854d0e;
            color: #fef08a;
            border: 1px solid #ca8a04;
        }

        .seat-doi {
            background: #831843;
            color: #fbcfe8;
            border: 1px solid #db2777;
            width: 78px;
        }

        .seat-item:hover:not(.seat-booked):not(.seat-holding) {
            transform: scale(1.15);
            filter: brightness(1.2);
        }

        .seat-selected {
            background: #10b981 !important;
            color: #ffffff !important;
            border-color: #059669 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.6);
        }

        .seat-booked {
            background: #475569 !important;
            color: #94a3b8 !important;
            border: 1px solid #334155 !important;
            cursor: not-allowed;
            opacity: 0.5;
        }

        .seat-holding {
            background: #d97706 !important;
            color: white !important;
            border-color: #b45309 !important;
            cursor: not-allowed;
        }

        .screen-curve {
            width: 80%;
            height: 14px;
            background: linear-gradient(to bottom, #38bdf8, transparent);
            margin: 0 auto 35px auto;
            border-radius: 50% 50% 0 0;
            box-shadow: 0 -4px 15px rgba(56, 189, 248, 0.4);
            text-align: center;
            font-size: 0.8rem;
            color: #94a3b8;
            line-height: 25px;
        }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="TrangChu" asp-action="Index">
                    <i class="bi bi-film text-danger fs-3"></i>
                    <span>CINE</span>BOOKING
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TrangChu" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Phim" asp-action="DanhSach" asp-route-trangThai="DangChieu">Phim đang chiếu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Phim" asp-action="DanhSach" asp-route-trangThai="SapChieu">Phim sắp chiếu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DatVe" asp-action="ChonRap">Cụm rạp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DatVe" asp-action="ChonSuatChieu">Lịch chiếu & Đặt vé</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LichSuDatVe" asp-action="Index">Vé của tôi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="ThongBao" asp-action="Index">
                                <i class="bi bi-bell-fill me-1"></i>Thông báo
                            </a>
                        </li>
                    </ul>

                    <form class="d-flex me-3" asp-controller="Phim" asp-action="DanhSach" method="get">
                        <div class="input-group">
                            <input class="form-control form-control-sm bg-dark text-light border-secondary" type="search" name="search" placeholder="Tìm tên phim, diễn viên..." />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        @if (maNguoiDung.HasValue)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-cinema dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle text-danger"></i>
                                    <span>@hoTen</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                    <li class="px-3 py-2 text-muted small border-bottom border-secondary">
                                        Vai trò: <span class="badge bg-danger">@vaiTro</span>
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="ThongTinCaNhan"><i class="bi bi-person me-2"></i>Thông tin cá nhân</a></li>
                                    @if (vaiTro == "QuanTriVien" || vaiTro == "NhanVien")
                                    {
                                        <li><a class="dropdown-item text-warning" href="http://localhost:5074" target="_blank"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-cinema btn-sm">Đăng nhập</a>
                            <a asp-controller="TaiKhoan" asp-action="DangKy" class="btn btn-cinema btn-sm">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show bg-success text-white border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-film text-danger"></i> CINEBOOKING
                    </h5>
                    <p class="small">
                        Hệ thống đặt vé xem phim trực tuyến hiện đại hàng đầu Việt Nam. Trải nghiệm xem phim đỉnh cao với cụm rạp tiêu chuẩn quốc tế 2D, 3D, IMAX.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Chính sách</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Chính sách đổi trả vé</a></li>
                        <li><a href="#">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Dịch vụ microservices</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><span class="text-secondary">• Dịch vụ Quản lý Người dùng</span></li>
                        <li><span class="text-secondary">• Dịch vụ Quản lý Phim</span></li>
                        <li><span class="text-secondary">• Dịch vụ Quản lý Rạp chiếu</span></li>
                        <li><span class="text-secondary">• Dịch vụ Quản lý Suất chiếu</span></li>
                        <li><span class="text-secondary">• Dịch vụ Quản lý Ghế ngồi</span></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Hỗ trợ khách hàng</h6>
                    <div class="small d-flex flex-column gap-2">
                        <div><i class="bi bi-telephone-fill text-danger me-2"></i>Hotline: 1900 6868 (8:00 - 22:00)</div>
                        <div><i class="bi bi-envelope-fill text-danger me-2"></i>Email: cskh@cinebooking.vn</div>
                        <div><i class="bi bi-geo-alt-fill text-danger me-2"></i>Hà Nội & TP. Hồ Chí Minh</div>
                    </div>
                </div>
            </div>
            <div class="border-top border-secondary pt-3 text-center small">
                &copy; 2026 CINEBOOKING System. Thiết kế kiến trúc theo tài liệu <strong>Xây dựng cơ sở dữ liệu.docx</strong>.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

