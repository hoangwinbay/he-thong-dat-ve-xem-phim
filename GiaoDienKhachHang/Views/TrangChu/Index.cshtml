@{
    ViewData["Title"] = "Trang chủ - Vé xem phim trực tuyến";
    var dangChieu = ViewBag.DangChieu as List<GiaoDienKhachHang.Models.Phim> ?? new List<GiaoDienKhachHang.Models.Phim>();
    var sapChieu = ViewBag.SapChieu as List<GiaoDienKhachHang.Models.Phim> ?? new List<GiaoDienKhachHang.Models.Phim>();
}

<!-- Hero Banner / Carousel -->
<div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner" style="max-height: 480px; background: #000;">
        <div class="carousel-item active" style="height: 480px; position: relative;">
            <div style="background: linear-gradient(to right, rgba(11,15,25,0.95) 30%, rgba(11,15,25,0.2) 100%), radial-gradient(circle at 70% 50%, rgba(225,29,72,0.4), #0b0f19); height: 100%; display: flex; align-items: center;">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7">
                            <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase fw-bold">Bom tấn tháng này</span>
                            <h1 class="display-4 fw-bold text-white mb-3">Đỉnh Cao Trải Nghiệm Điện Ảnh</h1>
                            <p class="lead text-light mb-4">Trải nghiệm âm thanh vòm Dolby Atmos đa chiều cùng màn hình laser IMAX siêu nét. Đặt vé trước để giữ ngay vị trí ghế VIP trung tâm!</p>
                            <div class="d-flex gap-3">
                                <a asp-controller="DatVe" asp-action="ChonSuatChieu" class="btn btn-cinema btn-lg px-4">
                                    <i class="bi bi-ticket-perforated-fill me-2"></i>Đặt vé ngay
                                </a>
                                <a asp-controller="Phim" asp-action="DanhSach" class="btn btn-outline-cinema btn-lg px-4">
                                    <i class="bi bi-collection-play me-2"></i>Xem tất cả phim
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item" style="height: 480px; position: relative;">
            <div style="background: linear-gradient(to right, rgba(11,15,25,0.95) 30%, rgba(11,15,25,0.2) 100%), radial-gradient(circle at 70% 50%, rgba(245,158,11,0.4), #0b0f19); height: 100%; display: flex; align-items: center;">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7">
                            <span class="badge bg-warning text-dark mb-2 px-3 py-2 text-uppercase fw-bold">Ưu đãi thành viên</span>
                            <h1 class="display-4 fw-bold text-white mb-3">Thành Viên CINEBOOKING</h1>
                            <p class="lead text-light mb-4">Tích điểm đổi bắp nước miễn phí và nhận voucher giảm giá 20% vào mỗi thứ Tư vui vẻ hàng tuần trên toàn hệ thống!</p>
                            <div class="d-flex gap-3">
                                <a asp-controller="TaiKhoan" asp-action="DangKy" class="btn btn-warning text-dark fw-bold btn-lg px-4">Đăng ký thành viên</a>
                                <a asp-controller="DatVe" asp-action="ChonRap" class="btn btn-outline-cinema btn-lg px-4">Khám phá rạp</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item" style="height: 480px; position: relative;">
            <div style="background: linear-gradient(to right, rgba(11,15,25,0.95) 30%, rgba(11,15,25,0.2) 100%), radial-gradient(circle at 70% 50%, rgba(59,130,246,0.4), #0b0f19); height: 100%; display: flex; align-items: center;">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7">
                            <span class="badge bg-primary mb-2 px-3 py-2 text-uppercase fw-bold">Phòng chiếu Gold Class</span>
                            <h1 class="display-4 fw-bold text-white mb-3">Ghế Đôi Sweetbox & Ghế VIP Da</h1>
                            <p class="lead text-light mb-4">Tận hưởng không gian riêng tư, phục vụ nước ngọt và chăn ấm miễn phí cho bạn và người thân.</p>
                            <div class="d-flex gap-3">
                                <a asp-controller="DatVe" asp-action="ChonSuatChieu" class="btn btn-cinema btn-lg px-4">Chọn suất chiếu</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<div class="container">
    <!-- Phim đang chiếu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                <span style="display:inline-block; width:4px; height:24px; background:var(--accent-red); border-radius:2px;"></span>
                PHIM ĐANG CHIẾU
            </h2>
            <small class="text-muted">Các bộ phim hot nhất đang được công chiếu tại tất cả các cụm rạp</small>
        </div>
        <a asp-controller="Phim" asp-action="DanhSach" asp-route-trangThai="DangChieu" class="btn btn-outline-cinema btn-sm">
            Xem tất cả (@dangChieu.Count) <i class="bi bi-chevron-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4 mb-5">
        @if (!dangChieu.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-film fs-1 d-block mb-3"></i>
                Hiện chưa có phim nào đang chiếu.
            </div>
        }
        else
        {
            @foreach (var phim in dangChieu)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                    <div class="card card-custom h-100">
                        <div class="poster-wrapper">
                            @if (!string.IsNullOrEmpty(phim.Poster))
                            {
                                <img src="@phim.Poster" alt="@phim.TenPhim" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(phim.DoTuoi))
                            {
                                <span class="badge badge-age @(phim.DoTuoi.Contains("18") ? "bg-danger" : phim.DoTuoi.Contains("16") ? "bg-warning text-dark" : "bg-success")">
                                    @phim.DoTuoi
                                </span>
                            }
                            <span class="badge badge-rating">
                                <i class="bi bi-star-fill me-1"></i>4.8
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-white mb-1 text-truncate" title="@phim.TenPhim">
                                @phim.TenPhim
                            </h6>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-clock me-1"></i>@phim.ThoiLuong phút
                                @if (phim.PhimTheLoais.Any())
                                {
                                    <span class="mx-1">•</span>
                                    <span>@string.Join(", ", phim.PhimTheLoais.Select(t => t.TheLoai?.TenTheLoai).Where(t => t != null).Take(2))</span>
                                }
                            </div>
                            <div class="mt-auto d-flex gap-2 pt-2">
                                <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim" class="btn btn-outline-secondary btn-sm flex-fill">
                                    Chi tiết
                                </a>
                                <a asp-controller="DatVe" asp-action="ChonSuatChieu" asp-route-maPhim="@phim.MaPhim" class="btn btn-cinema btn-sm flex-fill">
                                    <i class="bi bi-ticket-perforated me-1"></i>Đặt vé
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Phim sắp chiếu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                <span style="display:inline-block; width:4px; height:24px; background:var(--accent-gold); border-radius:2px;"></span>
                PHIM SẮP CHIẾU
            </h2>
            <small class="text-muted">Đón chờ những siêu phẩm điện ảnh sắp đổ bộ phòng vé</small>
        </div>
        <a asp-controller="Phim" asp-action="DanhSach" asp-route-trangThai="SapChieu" class="btn btn-outline-cinema btn-sm">
            Xem tất cả <i class="bi bi-chevron-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4 mb-5">
        @if (!sapChieu.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-film fs-1 d-block mb-3"></i>
                Hiện chưa có danh sách phim sắp chiếu.
            </div>
        }
        else
        {
            @foreach (var phim in sapChieu)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                    <div class="card card-custom h-100">
                        <div class="poster-wrapper">
                            @if (!string.IsNullOrEmpty(phim.Poster))
                            {
                                <img src="@phim.Poster" alt="@phim.TenPhim" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            <span class="badge badge-age bg-primary">SẮP CHIẾU</span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-white mb-1 text-truncate" title="@phim.TenPhim">
                                @phim.TenPhim
                            </h6>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-calendar-event me-1"></i>Khởi chiếu: @(phim.NgayKhoiChieu?.ToString("dd/MM/yyyy") ?? "Sắp công bố")
                            </div>
                            <div class="mt-auto pt-2">
                                <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.MaPhim" class="btn btn-outline-warning btn-sm w-100">
                                    Xem Trailer & Thông tin
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Features Banner -->
    <div class="card bg-card border-secondary p-4 rounded-4 mb-4">
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="fs-2 text-danger mb-2"><i class="bi bi-tv-fill"></i></div>
                <h6 class="fw-bold text-white">Màn hình Laser IMAX</h6>
                <p class="small text-muted mb-0">Độ tương phản siêu sâu và màu sắc chân thực</p>
            </div>
            <div class="col-md-3 col-6">
                <div class="fs-2 text-warning mb-2"><i class="bi bi-soundwave"></i></div>
                <h6 class="fw-bold text-white">Dolby Atmos</h6>
                <p class="small text-muted mb-0">Hệ thống âm thanh không gian 360 độ cực sống động</p>
            </div>
            <div class="col-md-3 col-6">
                <div class="fs-2 text-info mb-2"><i class="bi bi-armchair-fill"></i></div>
                <h6 class="fw-bold text-white">Ghế VIP & Sweetbox</h6>
                <p class="small text-muted mb-0">Ghế da nhập khẩu ngả lưng êm ái tối đa</p>
            </div>
            <div class="col-md-3 col-6">
                <div class="fs-2 text-success mb-2"><i class="bi bi-qr-code-scan"></i></div>
                <h6 class="fw-bold text-white">Vé điện tử QR tiện lợi</h6>
                <p class="small text-muted mb-0">Vào rạp nhanh chóng không cần xếp hàng in vé</p>
            </div>
        </div>
    </div>
</div>

