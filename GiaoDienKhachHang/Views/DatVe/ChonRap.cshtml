@model IEnumerable<GiaoDienKhachHang.Models.RapChieu>
@{
    ViewData["Title"] = "Hệ thống cụm rạp";
    var phim = ViewBag.Phim as GiaoDienKhachHang.Models.Phim;
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-4">
        <h2 class="text-white fw-bold">HỆ THỐNG CỤM RẠP CINEBOOKING</h2>
        <p class="text-muted">Trải nghiệm rạp chiếu phim hiện đại với công nghệ hình ảnh & âm thanh tiêu chuẩn quốc tế</p>
        @if (phim != null)
        {
            <div class="alert alert-info d-inline-block py-2 px-4 border-0">
                <i class="bi bi-info-circle me-2"></i>Đang lọc rạp cho phim: <strong>@phim.TenPhim</strong>
            </div>
        }
    </div>

    <div class="row g-4">
        @foreach (var rap in Model)
        {
            <div class="col-lg-6">
                <div class="card bg-card border-secondary rounded-4 h-100 p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="text-white fw-bold mb-1">
                                <i class="bi bi-building text-danger me-2"></i>@rap.TenRap
                            </h4>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@rap.DiaChi</p>
                            @if (!string.IsNullOrEmpty(rap.SoDienThoai))
                            {
                                <span class="badge bg-dark border border-secondary text-light">
                                    <i class="bi bi-telephone me-1"></i>@rap.SoDienThoai
                                </span>
                            }
                        </div>
                        <span class="badge bg-success">Đang hoạt động</span>
                    </div>

                    <div class="border-top border-secondary pt-3 mt-auto d-flex gap-2">
                        @if (phim != null)
                        {
                            <a asp-action="ChonSuatChieu" asp-route-maPhim="@phim.MaPhim" asp-route-maRap="@rap.MaRap" class="btn btn-cinema flex-fill">
                                <i class="bi bi-clock me-1"></i>Xem suất chiếu phim này
                            </a>
                        }
                        else
                        {
                            <a asp-action="ChonSuatChieu" asp-route-maRap="@rap.MaRap" class="btn btn-cinema flex-fill">
                                <i class="bi bi-calendar3 me-1"></i>Xem tất cả suất chiếu
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

