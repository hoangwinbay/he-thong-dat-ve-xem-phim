@model List<GiaoDienKhachHang.Models.DatVe>
@{
    ViewData["Title"] = "Lịch sử đặt vé";
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="text-white fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-danger"></i> LỊCH SỬ ĐẶT VÉ
            </h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái các đơn đặt vé xem phim của bạn</p>
        </div>
        <div>
            <a href="/" class="btn btn-outline-danger rounded-pill px-4">
                <i class="bi bi-film me-1"></i> Đặt thêm vé mới
            </a>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tra cứu qua email nếu chưa đăng nhập -->
    <div class="card bg-card border-secondary rounded-4 p-3 mb-4 shadow-sm">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="email" name="emailTraCuu" class="form-control bg-dark border-secondary text-white" 
                           value="@ViewBag.EmailTraCuu" placeholder="Nhập email bạn đã dùng đặt vé để tra cứu..." />
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-cinema w-100 rounded-pill">
                    <i class="bi bi-funnel me-1"></i> Tra cứu vé
                </button>
            </div>
        </form>
    </div>

    <!-- Danh sách đơn đặt vé -->
    @if (Model == null || !Model.Any())
    {
        <div class="card bg-card border-secondary rounded-4 p-5 text-center my-4">
            <div class="text-muted mb-3">
                <i class="bi bi-ticket-detailed display-1 text-secondary"></i>
            </div>
            <h5 class="text-white fw-bold">Chưa có đơn đặt vé nào</h5>
            <p class="text-muted small">Bạn chưa thực hiện đặt vé hoặc không tìm thấy đơn vé nào với thông tin đã nhập.</p>
            <div class="mt-3">
                <a href="/" class="btn btn-danger rounded-pill px-4 py-2">Khám phá phim đang chiếu</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var dv in Model)
            {
                var suatChieu = dv.SuatChieu;
                var phim = suatChieu?.Phim;
                var phong = suatChieu?.PhongChieu;
                var rap = phong?.RapChieu;
                var ghes = dv.ChiTietDatVes.Select(ct => ct.GheSuatChieu?.GheNgoi).Where(g => g != null).ToList();

                <div class="col-12">
                    <div class="card bg-card border-secondary rounded-4 p-4 shadow-sm position-relative overflow-hidden">
                        <!-- Top Bar: Mã đơn & Trạng thái -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3 gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fs-5 fw-bold text-white">
                                    Đơn đặt vé <span class="text-danger">#@dv.MaDatVe</span>
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-calendar-event me-1"></i>Đặt lúc: @dv.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                            <div>
                                @if (dv.TrangThai == "ChoThanhToan")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6">
                                        <i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán
                                    </span>
                                }
                                else if (dv.TrangThai == "DaThanhToan")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                    </span>
                                }
                                else if (dv.TrangThai == "DaHuy")
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">
                                        <i class="bi bi-x-circle me-1"></i>Đã hủy
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">
                                        <i class="bi bi-exclamation-circle me-1"></i>@dv.TrangThai
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Thông tin chi tiết vé -->
                        <div class="row g-3 align-items-center">
                            <!-- Poster & Tên phim -->
                            <div class="col-md-5 d-flex gap-3 align-items-center">
                                @if (!string.IsNullOrEmpty(phim?.Poster))
                                {
                                    <img src="@phim.Poster" alt="@phim.TenPhim" class="rounded-3 shadow" style="width: 75px; height: 110px; object-fit: cover;" />
                                }
                                <div>
                                    <h5 class="text-white fw-bold mb-1">@phim?.TenPhim</h5>
                                    <div class="small text-muted mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@rap?.TenRap • <strong class="text-light">@phong?.TenPhong</strong>
                                    </div>
                                    <div class="small text-warning">
                                        <i class="bi bi-clock-fill me-1"></i>@suatChieu?.GioBatDau.ToString(@"hh\:mm") - @suatChieu?.NgayChieu.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>

                            <!-- Ghế đã đặt -->
                            <div class="col-md-4">
                                <div class="small text-muted mb-1">Danh sách ghế:</div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var g in ghes)
                                    {
                                        <span class="badge bg-danger px-2 py-1">@g?.HangGhe@g?.SoGhe</span>
                                    }
                                </div>
                                <div class="small text-muted mt-2">
                                    Khách hàng: <strong class="text-light">@(dv.NguoiDung?.HoTen ?? "Khách")</strong> (@(dv.NguoiDung?.Email ?? ""))
                                </div>
                            </div>

                            <!-- Tổng tiền & Thao tác -->
                            <div class="col-md-3 text-md-end">
                                <div class="small text-muted mb-1">Tổng tiền thanh toán:</div>
                                <div class="fs-4 fw-bold text-danger mb-3">@dv.TongTien.ToString("N0") đ</div>

                                @if (dv.TrangThai == "DaThanhToan")
                                {
                                    <div class="d-flex flex-column gap-2 mb-2">
                                        <a href="/VeDienTu/DonDatVe?maDatVe=@dv.MaDatVe" class="btn btn-warning btn-sm w-100 rounded-pill fw-bold text-dark shadow-sm">
                                            <i class="bi bi-qr-code-scan me-1"></i>Xem Vé & QR
                                        </a>
                                    </div>
                                }

                                @if (dv.TrangThai == "ChoThanhToan")
                                {
                                    <div class="d-flex flex-column gap-2">
                                        <a href="/ThanhToan/Index?maDatVe=@dv.MaDatVe" class="btn btn-cinema btn-sm w-100 rounded-pill fw-bold">
                                            <i class="bi bi-credit-card-fill me-1"></i>Thanh to�n ngay
                                        </a>
                                        <form asp-action="HuyDon" asp-controller="LichSuDatVe" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt vé này không? Các ghế sẽ được giải phóng.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dv.MaDatVe" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Hủy đơn vé
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

