@model GiaoDienQuanTri.Models.TheLoai
@{
    ViewData["Title"] = "Thêm thể loại";
}

<div class="card col-lg-6 mx-auto">
    <div class="card-header bg-warning text-dark py-3 fw-bold">
        <i class="bi bi-tag-fill me-2"></i> Thêm Thể Loại Phim Mới
    </div>
    <div class="card-body p-4">
        <form asp-action="Them" method="post">
            <div class="mb-3">
                <label asp-for="TenTheLoai" class="form-label fw-bold">Tên Thể Loại *</label>
                <input asp-for="TenTheLoai" class="form-control" placeholder="Ví dụ: Hành Động, Kinh Dị..." required />
                <span asp-validation-for="TenTheLoai" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i> Lưu thể loại</button>
            </div>
        </form>
    </div>
</div>

