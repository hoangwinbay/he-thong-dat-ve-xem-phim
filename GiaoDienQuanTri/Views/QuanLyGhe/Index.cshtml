@model IEnumerable<GiaoDienQuanTri.Models.GheNgoi>
@{
    ViewData["Title"] = "Quản lý ghế ngồi";
    var phongs = ViewBag.Phongs as List<GiaoDienQuanTri.Models.PhongChieu> ?? new();
    int selectedPhong = (int)ViewBag.SelectedPhong;
    var currentPhong = ViewBag.CurrentPhong as GiaoDienQuanTri.Models.PhongChieu;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">
        <i class="bi bi-square text-purple me-2" style="color: #6f42c1;"></i> Quản Lý Sơ Đồ Ghế (Dịch Vụ 5)
    </h3>
    @if (selectedPhong > 0)
    {
        <div class="d-flex gap-2">
            <a asp-action="SoDoGhe" asp-route-maPhong="@selectedPhong" class="btn btn-outline-primary">
                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Xem giao diện trực quan
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalThemGhe">
                <i class="bi bi-plus-circle me-1"></i> Thêm ghế đơn
            </button>
            <form asp-action="TaoSoDoMacDinh" asp-route-maPhong="@selectedPhong" method="post" class="d-inline" onsubmit="return confirm('Khởi tạo tự động sẽ tạo mới lại sơ đồ ghế cho phòng này. Tiếp tục?');">
                <button type="submit" class="btn btn-warning"><i class="bi bi-magic me-1"></i> Sinh tự động sơ đồ chuẩn</button>
            </form>
        </div>
    }
</div>

<!-- Bộ chọn phòng chiếu -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-2 fw-bold text-muted">Chọn phòng chiếu:</div>
            <div class="col-md-8">
                <select name="maPhong" class="form-select" onchange="this.form.submit()">
                    @foreach (var p in phongs)
                    {
                        <option value="@p.MaPhong" selected="@(selectedPhong == p.MaPhong)">
                            @p.RapChieu?.TenRap - @p.TenPhong (@p.LoaiPhong) - (@p.GheNgois.Count ghế)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 text-end">
                <span class="badge bg-secondary p-2 w-100">Tổng: @Model.Count() ghế</span>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách ghế trong phòng -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Hàng Ghế</th>
                        <th>Số Ghế</th>
                        <th>Ký Hiệu Ghế</th>
                        <th>Phân Loại Ghế</th>
                        <th>Trạng Thái</th>
                        <th class="text-center" style="width: 120px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.MaGhe</td>
                            <td><strong class="text-primary fs-5">@g.HangGhe</strong></td>
                            <td><strong class="fs-5">@g.SoGhe</strong></td>
                            <td><span class="badge bg-dark fs-6">@g.HangGhe@g.SoGhe</span></td>
                            <td>
                                @if (g.LoaiGhe == "VIP")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> Ghế VIP</span>
                                }
                                else if (g.LoaiGhe == "Doi")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-heart-fill"></i> Ghế Đôi (Sweetbox)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ghế Thường</span>
                                }
                            </td>
                            <td>
                                @if (g.TrangThai)
                                {
                                    <span class="badge bg-success">Tốt</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hỏng / Khóa</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Xoa" asp-route-id="@g.MaGhe" asp-route-maPhong="@g.MaPhong" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa ghế này?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal thêm ghế đơn -->
<div class="modal fade" id="modalThemGhe" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Them" method="post">
                <input type="hidden" name="MaPhong" value="@selectedPhong" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-1"></i> Thêm Ghế Đơn Lẻ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hàng Ghế (Ký tự chữ cái: A, B, C...) *</label>
                        <input type="text" name="HangGhe" class="form-control" maxlength="2" placeholder="A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số Ghế (Thứ tự từ 1...) *</label>
                        <input type="number" name="SoGhe" class="form-control" min="1" placeholder="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Loại Ghế *</label>
                        <select name="LoaiGhe" class="form-select">
                            <option value="Thuong">Ghế Thường</option>
                            <option value="VIP">Ghế VIP</option>
                            <option value="Doi">Ghế Đôi (Sweetbox)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Thêm Ghế</button>
                </div>
            </form>
        </div>
    </div>
</div>

