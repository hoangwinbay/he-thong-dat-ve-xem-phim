@model IEnumerable<GiaoDienQuanTri.Models.GheNgoi>
@{
    var phong = ViewBag.Phong as GiaoDienQuanTri.Models.PhongChieu;
    ViewData["Title"] = "Sơ đồ ghế trực quan - " + phong?.TenPhong;
    var rows = Model.GroupBy(g => g.HangGhe).OrderBy(g => g.Key).ToList();
}

<div class="card col-lg-10 mx-auto">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-bold fs-5"><i class="bi bi-grid-3x3-gap-fill me-2 text-warning"></i> Sơ Đồ Phòng: @phong?.TenPhong (@phong?.LoaiPhong)</span>
            <div class="small text-muted">@phong?.RapChieu?.TenRap</div>
        </div>
        <a asp-action="Index" asp-route-maPhong="@phong?.MaPhong" class="btn btn-sm btn-outline-light">
            <i class="bi bi-list me-1"></i> Dạng danh sách
        </a>
    </div>
    <div class="card-body p-4 text-center">
        <!-- Chú thích loại ghế -->
        <div class="d-flex justify-content-center gap-4 mb-4 small">
            <div><span class="badge bg-secondary p-2 me-1"></span> Ghế Thường</div>
            <div><span class="badge bg-warning text-dark p-2 me-1"></span> Ghế VIP</div>
            <div><span class="badge bg-danger p-2 me-1"></span> Ghế Đôi (Sweetbox)</div>
        </div>

        <!-- Màn hình chiếu -->
        <div class="alert alert-secondary py-2 w-75 mx-auto mb-5 fw-bold shadow-sm" style="letter-spacing: 4px; border-bottom: 4px solid #adb5bd;">
            <i class="bi bi-tv me-2"></i> MÀN HÌNH CHIẾU PHIM
        </div>

        <!-- Các hàng ghế -->
        <div class="d-flex flex-column gap-3 mb-5 align-items-center">
            @foreach (var r in rows)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-muted me-2" style="width: 20px;">@r.Key</span>
                    @foreach (var g in r.OrderBy(x => x.SoGhe))
                    {
                        string btnClass = "btn-secondary";
                        string widthStyle = "width: 44px;";
                        if (g.LoaiGhe == "VIP") btnClass = "btn-warning text-dark";
                        else if (g.LoaiGhe == "Doi")
                        {
                            btnClass = "btn-danger";
                            widthStyle = "width: 75px;";
                        }

                        <button type="button" class="btn btn-sm @btnClass shadow-sm" style="@widthStyle height: 38px; font-size: 0.8rem; font-weight: bold;" title="@g.HangGhe@g.SoGhe (@g.LoaiGhe)">
                            @g.HangGhe@g.SoGhe
                        </button>
                    }
                    <span class="fw-bold text-muted ms-2" style="width: 20px;">@r.Key</span>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-route-maPhong="@phong?.MaPhong" class="btn btn-secondary">Quay lại quản lý ghế</a>
        </div>
    </div>
</div>

