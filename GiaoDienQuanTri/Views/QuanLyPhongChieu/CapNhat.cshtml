@model GiaoDienQuanTri.Models.PhongChieu
@{
    ViewData["Title"] = "Cập nhật phòng chiếu";
    var raps = ViewBag.Raps as List<GiaoDienQuanTri.Models.RapChieu> ?? new();
}

<div class="card col-lg-7 mx-auto">
    <div class="card-header bg-warning text-dark py-3 fw-bold">
        <i class="bi bi-pencil-square me-2"></i> Cập Nhật Phòng Chiếu #@Model.MaPhong
    </div>
    <div class="card-body p-4">
        <form asp-action="CapNhat" method="post">
            <input type="hidden" asp-for="MaPhong" />

            <div class="mb-3">
                <label asp-for="MaRap" class="form-label fw-bold">Thuộc Cụm Rạp *</label>
                <select asp-for="MaRap" class="form-select" required>
                    @foreach (var r in raps)
                    {
                        <option value="@r.MaRap" selected="@(Model.MaRap == r.MaRap)">@r.TenRap</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="TenPhong" class="form-label fw-bold">Tên Phòng Chiếu *</label>
                <input asp-for="TenPhong" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="LoaiPhong" class="form-label fw-bold">Công Nghệ / Định Dạng Chiếu</label>
                <select asp-for="LoaiPhong" class="form-select">
                    <option value="2D">2D Tiêu Chuẩn</option>
                    <option value="3D">3D Dolby Atmos</option>
                    <option value="IMAX">IMAX Laser</option>
                    <option value="4DX">4DX Trải Nghiệm</option>
                    <option value="ScreenX">ScreenX 270 Độ</option>
                    <option value="VIP">Gold Class / First Class VIP</option>
                </select>
            </div>

            <div class="mb-4">
                <label asp-for="SoLuongGhe" class="form-label fw-bold">Sức Chứa (Số Ghế)</label>
                <input asp-for="SoLuongGhe" type="number" class="form-control" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-1"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

