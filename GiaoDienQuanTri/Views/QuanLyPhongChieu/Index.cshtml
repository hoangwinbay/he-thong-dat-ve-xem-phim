@model IEnumerable<GiaoDienQuanTri.Models.PhongChieu>
@{
    ViewData["Title"] = "Quản lý phòng chiếu";
    var raps = ViewBag.Raps as List<GiaoDienQuanTri.Models.RapChieu> ?? new();
    int? selectedRap = ViewBag.SelectedRap as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-door-open text-primary me-2"></i> Quản Lý Phòng Chiếu Phim</h3>
    <a asp-action="Them" asp-route-maRap="@selectedRap" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Thêm phòng chiếu mới</a>
</div>

<!-- Lọc theo rạp -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-2 text-muted fw-bold">Chọn rạp chiếu:</div>
            <div class="col-md-7">
                <select name="maRap" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả các cụm rạp --</option>
                    @foreach (var r in raps)
                    {
                        <option value="@r.MaRap" selected="@(selectedRap == r.MaRap)">@r.TenRap</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xem tất cả</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Cụm Rạp</th>
                        <th>Tên Phòng Chiếu</th>
                        <th>Công Nghệ Chiếu</th>
                        <th>Số Lượng Ghế</th>
                        <th>Sơ Đồ Ghế</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.MaPhong</td>
                            <td><strong class="text-secondary">@p.RapChieu?.TenRap</strong></td>
                            <td><strong class="text-primary fs-6">@p.TenPhong</strong></td>
                            <td>
                                <span class="badge bg-dark">@(p.LoaiPhong ?? "2D")</span>
                            </td>
                            <td>@(p.SoLuongGhe ?? p.GheNgois.Count) ghế</td>
                            <td>
                                <a asp-controller="QuanLyGhe" asp-action="Index" asp-route-maPhong="@p.MaPhong" class="badge bg-purple text-white text-decoration-none p-2" style="background-color: #6f42c1;">
                                    <i class="bi bi-grid-3x3-gap"></i> Xem sơ đồ ghế (@p.GheNgois.Count)
                                </a>
                            </td>
                            <td class="text-center">
                                <a asp-action="CapNhat" asp-route-id="@p.MaPhong" class="btn btn-sm btn-warning me-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <form asp-action="Xoa" asp-route-id="@p.MaPhong" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phòng chiếu này? Toàn bộ ghế sẽ bị xóa theo!');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

