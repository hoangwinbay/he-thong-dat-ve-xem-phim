@model IEnumerable<GiaoDienQuanTri.Models.DanhGiaPhim>
@{
    ViewData["Title"] = "Quản lý đánh giá phim";
    var tongSo = (int)(ViewBag.TongSoDanhGia ?? 0);
    var diemTb = (double)(ViewBag.DiemTrungBinh ?? 0);
    var so5Sao = (int)(ViewBag.SoLuong5Sao ?? 0);
    var so1Sao = (int)(ViewBag.SoLuong1Sao ?? 0);
    var phims = ViewBag.Phims as List<GiaoDienQuanTri.Models.Phim> ?? new();
    int? soSao = ViewBag.SoSao as int?;
    int? maPhim = ViewBag.MaPhim as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">
        <i class="bi bi-star-half text-warning me-2"></i> Quản Lý Đánh Giá Phim (Dịch Vụ 10)
    </h3>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill fw-bold">
        Điểm TB hệ thống: @(diemTb > 0 ? $"{diemTb:0.0} / 5.0 ⭐" : "Chưa có")
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hộp thống kê đánh giá -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tổng Lượt Đánh Giá</div>
                    <div class="fs-4 fw-bold text-dark">@tongSo</div>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                    <i class="bi bi-chat-heart fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Điểm Đánh Giá TB</div>
                    <div class="fs-4 fw-bold text-warning">@(diemTb > 0 ? $"{diemTb:0.0}" : "0") ⭐</div>
                </div>
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                    <i class="bi bi-star-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Đánh Giá 5 Sao</div>
                    <div class="fs-4 fw-bold text-success">@so5Sao</div>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                    <i class="bi bi-hand-thumbs-up fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Đánh Giá 1 Sao</div>
                    <div class="fs-4 fw-bold text-danger">@so1Sao</div>
                </div>
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3">
                    <i class="bi bi-hand-thumbs-down fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Từ khóa bình luận, tên khách hàng..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="maPhim" class="form-select">
                    <option value="">-- Tất cả phim --</option>
                    @foreach (var p in phims)
                    {
                        <option value="@p.MaPhim" selected="@(maPhim == p.MaPhim)">@p.TenPhim</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="soSao" class="form-select">
                    <option value="">-- Số sao --</option>
                    <option value="5" selected="@(soSao == 5)">5 Sao ⭐⭐⭐⭐⭐</option>
                    <option value="4" selected="@(soSao == 4)">4 Sao ⭐⭐⭐⭐</option>
                    <option value="3" selected="@(soSao == 3)">3 Sao ⭐⭐⭐</option>
                    <option value="2" selected="@(soSao == 2)">2 Sao ⭐⭐</option>
                    <option value="1" selected="@(soSao == 1)">1 Sao ⭐</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách đánh giá -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã</th>
                        <th>Phim</th>
                        <th>Khán Giả</th>
                        <th>Điểm Sao</th>
                        <th>Nội Dung Bình Luận</th>
                        <th>Ngày Đánh Giá</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-star display-6 d-block mb-2 text-secondary"></i>
                                Không có đánh giá nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.MaDanhGia</td>
                            <td>
                                <div class="fw-bold text-dark">@(item.Phim?.TenPhim ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(item.NguoiDung?.HoTen ?? "Khách hàng")</div>
                                <div class="text-muted small">@(item.NguoiDung?.Email ?? "")</div>
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                                    @item.SoSao ⭐
                                </span>
                            </td>
                            <td>
                                <div class="text-dark small text-truncate" style="max-width: 320px;">
                                    @(string.IsNullOrWhiteSpace(item.BinhLuan) ? "(Không để lại bình luận)" : item.BinhLuan)
                                </div>
                            </td>
                            <td class="small text-muted">
                                @item.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaDanhGia" class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Xoa" asp-route-id="@item.MaDanhGia" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa đánh giá này">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
