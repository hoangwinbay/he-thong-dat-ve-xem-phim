@model IEnumerable<GiaoDienQuanTri.Models.ThongBao>
@{
    ViewData["Title"] = "Quản lý thông báo";
    var tongSo = (int)(ViewBag.TongSo ?? 0);
    var soChuaDoc = (int)(ViewBag.SoChuaDoc ?? 0);
    var soDaDoc = (int)(ViewBag.SoDaDoc ?? 0);
    bool? daDoc = ViewBag.DaDoc as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">
        <i class="bi bi-bell-fill text-warning me-2"></i> Quản Lý Thông Báo (Dịch Vụ 9)
    </h3>
    <div>
        <a asp-action="TaoMoi" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-send-fill me-1"></i> Soạn & Gửi Thông Báo Mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hộp thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tổng Số Thông Báo</div>
                    <div class="fs-4 fw-bold text-dark">@tongSo</div>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                    <i class="bi bi-bell fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Khách Chưa Đọc</div>
                    <div class="fs-4 fw-bold text-danger">@soChuaDoc</div>
                </div>
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3">
                    <i class="bi bi-envelope-exclamation fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Khách Đã Đọc</div>
                    <div class="fs-4 fw-bold text-success">@soDaDoc</div>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                    <i class="bi bi-envelope-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm theo tiêu đề, nội dung, tên khách hàng hoặc email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="daDoc" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="false" selected="@(daDoc == false)">Chưa đọc</option>
                    <option value="true" selected="@(daDoc == true)">Đã đọc</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách thông báo -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã</th>
                        <th>Người Nhận</th>
                        <th>Tiêu Đề Thông Báo</th>
                        <th>Nội Dung Tóm Tắt</th>
                        <th>Thời Gian Gửi</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-bell-slash display-6 d-block mb-2 text-secondary"></i>
                                Không có thông báo nào phù hợp.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.MaThongBao</td>
                            <td>
                                <div class="fw-bold text-dark">@(item.NguoiDung?.HoTen ?? "Khách hàng")</div>
                                <div class="text-muted small">@(item.NguoiDung?.Email ?? "")</div>
                            </td>
                            <td>
                                <span class="fw-bold text-primary">@item.TieuDe</span>
                            </td>
                            <td>
                                <div class="text-muted small text-truncate" style="max-width: 320px;">
                                    @item.NoiDung
                                </div>
                            </td>
                            <td class="small text-muted">
                                @item.NgayGui.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (!item.DaDoc)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-envelope-exclamation me-1"></i>Chưa đọc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-envelope-check me-1"></i>Đã đọc
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaThongBao" class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Xoa" asp-route-id="@item.MaThongBao" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thông báo này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa thông báo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
