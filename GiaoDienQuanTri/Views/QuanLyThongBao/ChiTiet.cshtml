@model GiaoDienQuanTri.Models.ThongBao
@{
    ViewData["Title"] = $"Chi tiết thông báo #{Model.MaThongBao}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách thông báo
        </a>
        <h3 class="fw-bold mb-0 text-dark">
            Chi Tiết Thông Báo #@Model.MaThongBao
        </h3>
    </div>
    <div>
        <form asp-action="Xoa" asp-route-id="@Model.MaThongBao" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thông báo này không?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-trash me-1"></i> Xóa thông báo
            </button>
        </form>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">THÔNG BÁO HỆ THỐNG</span>
                    @if (!Model.DaDoc)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Khách chưa đọc</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Khách đã đọc</span>
                    }
                </div>
                <div class="text-muted small">
                    <i class="bi bi-clock me-1"></i> @Model.NgayGui.ToString("dd/MM/yyyy HH:mm:ss")
                </div>
            </div>

            <h4 class="fw-bold text-dark mb-4">@Model.TieuDe</h4>

            <div class="p-4 bg-light rounded-3 mb-4 text-dark fs-6 lh-lg" style="white-space: pre-line;">
                @Model.NoiDung
            </div>

            <div class="card border bg-white rounded-3 p-3">
                <h6 class="fw-bold text-muted small text-uppercase mb-2">Thông tin người nhận:</h6>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-dark fs-6">@(Model.NguoiDung?.HoTen ?? "Khách hàng")</div>
                        <div class="text-muted small">Email: @(Model.NguoiDung?.Email ?? "N/A")</div>
                    </div>
                    <div>
                        <span class="badge bg-primary">@(Model.NguoiDung?.VaiTro ?? "KhachHang")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
