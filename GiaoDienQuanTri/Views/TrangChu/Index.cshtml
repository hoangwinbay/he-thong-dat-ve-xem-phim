@{
    ViewData["Title"] = "Bảng điều khiển";
    var recentMovies = ViewBag.RecentMovies as List<GiaoDienQuanTri.Models.Phim>;
    var todayShowtimes = ViewBag.TodayShowtimes as List<GiaoDienQuanTri.Models.SuatChieu>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 me-2"></i> Tổng Quan Hệ Thống</h3>
    <span class="badge bg-primary p-2"><i class="bi bi-hdd-rack me-1"></i> 5 Dịch vụ đang hoạt động</span>
</div>

<!-- 5 Thẻ thống kê tương ứng 5 dịch vụ -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 small">1. Người Dùng</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
                </div>
                <i class="bi bi-people-fill fs-1 opacity-50"></i>
            </div>
            <a asp-controller="QuanLyNguoiDung" asp-action="Index" class="text-white-50 small mt-2 d-inline-block text-decoration-none">
                Xem chi tiết <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card bg-danger text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 small">2. Phim Đang Chiếu</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalMovies</h2>
                </div>
                <i class="bi bi-film fs-1 opacity-50"></i>
            </div>
            <a asp-controller="QuanLyPhim" asp-action="Index" class="text-white-50 small mt-2 d-inline-block text-decoration-none">
                Quản lý kho phim <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4 col-sm-6">
        <div class="card bg-info text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 small">3. Cụm Rạp & Phòng</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalCinemas <small class="fs-6">(@ViewBag.TotalRooms phòng)</small></h2>
                </div>
                <i class="bi bi-building fs-1 opacity-50"></i>
            </div>
            <a asp-controller="QuanLyRap" asp-action="Index" class="text-white-50 small mt-2 d-inline-block text-decoration-none">
                Quản lý rạp chiếu <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-sm-6">
        <div class="card bg-warning text-dark p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 small">4. Suất Chiếu Phim</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalShowtimes</h2>
                </div>
                <i class="bi bi-calendar-check-fill fs-1 opacity-50"></i>
            </div>
            <a asp-controller="QuanLySuatChieu" asp-action="Index" class="text-dark small mt-2 d-inline-block text-decoration-none">
                Lịch chiếu hôm nay <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-sm-12">
        <div class="card bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 small">5. Sơ Đồ Ghế Ngồi</h6>
                    <h2 class="fw-bold mb-0">Hoạt Động</h2>
                </div>
                <i class="bi bi-grid-3x3-gap-fill fs-1 opacity-50"></i>
            </div>
            <a asp-controller="QuanLyGhe" asp-action="Index" class="text-white-50 small mt-2 d-inline-block text-decoration-none">
                Quản lý sơ đồ ghế các phòng <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Hai bảng hiển thị nhanh -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3 fw-bold">
                <i class="bi bi-film text-danger me-2"></i> Danh Sách Phim Mới Nhất
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên Phim</th>
                                <th>Thời Lượng</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentMovies != null)
                            {
                                foreach (var p in recentMovies)
                                {
                                    <tr>
                                        <td>
                                            <img src="/@p.Poster" class="poster-thumb" alt="@p.TenPhim" onerror="this.src='https://placehold.co/45x65?text=Phim';" />
                                        </td>
                                        <td>
                                            <strong>@p.TenPhim</strong>
                                            <div class="small text-muted">@p.QuocGia | @p.DoTuoi</div>
                                        </td>
                                        <td>@p.ThoiLuong phút</td>
                                        <td>
                                            @if (p.TrangThai == "DangChieu")
                                            {
                                                <span class="badge bg-success">Đang chiếu</span>
                                            }
                                            else if (p.TrangThai == "SapChieu")
                                            {
                                                <span class="badge bg-warning text-dark">Sắp chiếu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Ngừng chiếu</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white py-3 fw-bold">
                <i class="bi bi-clock-history text-warning me-2"></i> Suất Chiếu Sắp Diễn Ra
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Giờ</th>
                                <th>Phim</th>
                                <th>Phòng Chiếu</th>
                                <th>Giá Vé</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (todayShowtimes != null)
                            {
                                foreach (var s in todayShowtimes)
                                {
                                    <tr>
                                        <td><span class="badge bg-dark">@s.GioBatDau.ToString(@"hh\:mm") - @s.GioKetThuc.ToString(@"hh\:mm")</span></td>
                                        <td>@s.Phim?.TenPhim</td>
                                        <td>@s.PhongChieu?.TenPhong</td>
                                        <td class="text-danger fw-bold">@s.GiaVe.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

