@model IEnumerable<GiaoDienQuanTri.Models.NguoiDung>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-success me-2"></i> Quản Lý Người Dùng (Dịch Vụ 1)</h3>
    <a asp-action="Them" class="btn btn-success"><i class="bi bi-person-plus-fill me-1"></i> Thêm người dùng mới</a>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, email hoặc số điện thoại..." />
            </div>
            <div class="col-md-4">
                <select name="vaiTro" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="QuanTri" selected="@(ViewBag.VaiTro == "QuanTri")">Quản Trị Viên (QuanTri)</option>
                    <option value="NhanVien" selected="@(ViewBag.VaiTro == "NhanVien")">Nhân Viên (NhanVien)</option>
                    <option value="KhachHang" selected="@(ViewBag.VaiTro == "KhachHang")">Khách Hàng (KhachHang)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Vai Trò</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.MaNguoiDung</td>
                            <td><strong>@u.HoTen</strong></td>
                            <td>@u.Email</td>
                            <td>@(u.SoDienThoai ?? "Chưa có")</td>
                            <td>
                                @if (u.VaiTro == "QuanTri")
                                {
                                    <span class="badge bg-danger">Quản Trị</span>
                                }
                                else if (u.VaiTro == "NhanVien")
                                {
                                    <span class="badge bg-primary">Nhân Viên</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Khách Hàng</span>
                                }
                            </td>
                            <td>
                                @if (u.TrangThai)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Bị khóa</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ChiTiet" asp-route-id="@u.MaNguoiDung" class="btn btn-sm btn-info text-white me-1" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="CapNhat" asp-route-id="@u.MaNguoiDung" class="btn btn-sm btn-warning me-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <form asp-action="Xoa" asp-route-id="@u.MaNguoiDung" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

