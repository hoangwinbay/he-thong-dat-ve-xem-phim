@model GiaoDienQuanTri.Models.NguoiDung
@{
    ViewData["Title"] = "Thêm người dùng";
}

<div class="card col-lg-8 mx-auto">
    <div class="card-header bg-success text-white py-3 fw-bold">
        <i class="bi bi-person-plus-fill me-2"></i> Thêm Người Dùng Mới
    </div>
    <div class="card-body p-4">
        <form asp-action="Them" method="post">
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên *</label>
                <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" required />
                <span asp-validation-for="HoTen" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Email *</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label fw-bold">Mật Khẩu *</label>
                <input asp-for="MatKhau" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label fw-bold">Số Điện Thoại</label>
                <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" />
            </div>

            <div class="mb-3">
                <label asp-for="VaiTro" class="form-label fw-bold">Phân Quyền Vai Trò *</label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="KhachHang">Khách Hàng (KhachHang)</option>
                    <option value="NhanVien">Nhân Viên Soát Vé / Thu Ngân (NhanVien)</option>
                    <option value="QuanTri">Quản Trị Viên Hệ Thống (QuanTri)</option>
                </select>
            </div>

            <div class="form-check mb-4">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" checked />
                <label asp-for="TrangThai" class="form-check-label fw-bold">Kích hoạt tài khoản ngay</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i> Lưu người dùng</button>
            </div>
        </form>
    </div>
</div>

