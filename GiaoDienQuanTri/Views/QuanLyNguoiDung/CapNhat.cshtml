@model GiaoDienQuanTri.Models.NguoiDung
@{
    ViewData["Title"] = "Cập nhật người dùng";
}

<div class="card col-lg-8 mx-auto">
    <div class="card-header bg-warning text-dark py-3 fw-bold">
        <i class="bi bi-pencil-square me-2"></i> Cập Nhật Người Dùng #@Model.MaNguoiDung
    </div>
    <div class="card-body p-4">
        <form asp-action="CapNhat" method="post">
            <input type="hidden" asp-for="MaNguoiDung" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="MatKhau" />

            <div class="mb-3">
                <label class="form-label fw-bold">Email (Không đổi)</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên *</label>
                <input asp-for="HoTen" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label fw-bold">Số Điện Thoại</label>
                <input asp-for="SoDienThoai" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="VaiTro" class="form-label fw-bold">Phân Quyền Vai Trò *</label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="KhachHang">Khách Hàng (KhachHang)</option>
                    <option value="NhanVien">Nhân Viên (NhanVien)</option>
                    <option value="QuanTri">Quản Trị Viên (QuanTri)</option>
                </select>
            </div>

            <div class="form-check mb-4">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label fw-bold">Đang hoạt động</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-1"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>

