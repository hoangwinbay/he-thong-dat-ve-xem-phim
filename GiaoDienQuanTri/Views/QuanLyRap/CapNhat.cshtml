@model GiaoDienQuanTri.Models.RapChieu
@{
    ViewData["Title"] = "Cập nhật rạp";
}

<div class="card col-lg-7 mx-auto">
    <div class="card-header bg-warning text-dark py-3 fw-bold">
        <i class="bi bi-pencil-square me-2"></i> Cập Nhật Rạp: @Model.TenRap
    </div>
    <div class="card-body p-4">
        <form asp-action="CapNhat" method="post">
            <input type="hidden" asp-for="MaRap" />

            <div class="mb-3">
                <label asp-for="TenRap" class="form-label fw-bold">Tên Cụm Rạp *</label>
                <input asp-for="TenRap" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label fw-bold">Địa Chỉ Đầy Đủ</label>
                <textarea asp-for="DiaChi" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label fw-bold">Hotline Liên Hệ</label>
                <input asp-for="SoDienThoai" class="form-control" />
            </div>

            <div class="form-check mb-4">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label fw-bold">Rạp đang mở cửa đón khách</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-1"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

