@model GiaoDienQuanTri.Models.RapChieu
@{
    ViewData["Title"] = "Thêm rạp chiếu phim";
}

<div class="card col-lg-7 mx-auto">
    <div class="card-header bg-info text-white py-3 fw-bold">
        <i class="bi bi-building-add me-2"></i> Thêm Cụm Rạp Mới
    </div>
    <div class="card-body p-4">
        <form asp-action="Them" method="post">
            <div class="mb-3">
                <label asp-for="TenRap" class="form-label fw-bold">Tên Cụm Rạp *</label>
                <input asp-for="TenRap" class="form-control" placeholder="Ví dụ: CGV Vincom Center..." required />
            </div>

            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label fw-bold">Địa Chỉ Đầy Đủ</label>
                <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành phố..."></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label fw-bold">Hotline Liên Hệ</label>
                <input asp-for="SoDienThoai" class="form-control" placeholder="0243..." />
            </div>

            <div class="form-check mb-4">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" checked />
                <label asp-for="TrangThai" class="form-check-label fw-bold">Rạp đang mở cửa đón khách</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-info text-white"><i class="bi bi-save me-1"></i> Lưu Rạp Chiếu</button>
            </div>
        </form>
    </div>
</div>

