@model GiaoDienQuanTri.Models.SuatChieu
@{
    ViewData["Title"] = "Chi tiết suất chiếu";
    var ghes = Model.GheSuatChieus?.ToList() ?? new();
    int total = ghes.Count;
    int trong = ghes.Count(g => g.TrangThai == "Trong");
    int dangGiu = ghes.Count(g => g.TrangThai == "DangGiu");
    int daDat = ghes.Count(g => g.TrangThai == "DaDat");
}

<div class="card col-lg-10 mx-auto">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-calendar-event me-2"></i> Chi Tiết Suất Chiếu #@Model.MaSuatChieu</span>
        <span class="badge bg-warning text-dark fs-6">@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")</span>
    </div>
    <div class="card-body p-4">
        <div class="row mb-4">
            <div class="col-md-6">
                <h4 class="fw-bold text-danger">@Model.Phim?.TenPhim</h4>
                <div class="text-muted mb-2">Độ tuổi: <span class="badge bg-danger">@Model.Phim?.DoTuoi</span> | Thời lượng: @Model.Phim?.ThoiLuong phút</div>
                <div><strong>Cụm rạp:</strong> @Model.PhongChieu?.RapChieu?.TenRap</div>
                <div><strong>Phòng chiếu:</strong> @Model.PhongChieu?.TenPhong (@Model.PhongChieu?.LoaiPhong)</div>
                <div><strong>Ngày chiếu:</strong> @Model.NgayChieu.ToString("dd/MM/yyyy")</div>
                <div><strong>Giá vé cơ bản:</strong> <span class="text-danger fw-bold">@Model.GiaVe.ToString("N0") đ</span></div>
            </div>
            <div class="col-md-6">
                <div class="card bg-light p-3">
                    <h6 class="fw-bold mb-3 text-uppercase">Tình trạng bán vé</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tổng số ghế:</span>
                        <strong>@total</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span><i class="bi bi-square me-1"></i> Ghế còn trống:</span>
                        <strong>@trong</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-warning">
                        <span><i class="bi bi-hourglass-split me-1"></i> Đang giữ tạm thời:</span>
                        <strong>@dangGiu</strong>
                    </div>
                    <div class="d-flex justify-content-between text-danger">
                        <span><i class="bi bi-check-square-fill me-1"></i> Đã bán / Đã đặt:</span>
                        <strong>@daDat</strong>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="fw-bold mb-3"><i class="bi bi-grid-3x3-gap me-2"></i> Trạng Thái Ghế Của Suất Chiếu</h5>
        <div class="border rounded p-4 bg-light text-center mb-4">
            <div class="alert alert-secondary py-1 w-50 mx-auto mb-4 fw-bold shadow-sm">MÀN HÌNH CHIẾU</div>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                @foreach (var g in ghes.OrderBy(x => x.GheNgoi?.HangGhe).ThenBy(x => x.GheNgoi?.SoGhe))
                {
                    string colorClass = "btn-outline-success";
                    if (g.TrangThai == "DaDat") colorClass = "btn-danger disabled";
                    else if (g.TrangThai == "DangGiu") colorClass = "btn-warning text-dark";

                    <button type="button" class="btn btn-sm @colorClass" style="width: 48px; height: 42px; font-size: 0.75rem;" title="@g.GheNgoi?.LoaiGhe - @g.GiaVe.ToString("N0") đ">
                        @g.GheNgoi?.HangGhe@g.GheNgoi?.SoGhe
                    </button>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            <a asp-action="CapNhat" asp-route-id="@Model.MaSuatChieu" class="btn btn-warning"><i class="bi bi-pencil-square me-1"></i> Chỉnh sửa suất chiếu</a>
        </div>
    </div>
</div>

