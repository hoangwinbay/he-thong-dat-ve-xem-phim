@model GiaoDienQuanTri.Models.Phim
@{
    ViewData["Title"] = "Chi tiết phim - " + Model.TenPhim;
}

<div class="card col-lg-10 mx-auto">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-film me-2"></i> Chi Tiết Phim: @Model.TenPhim</span>
        <span class="badge bg-danger">@Model.DoTuoi</span>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-4 text-center mb-3">
                <img src="/@Model.Poster" class="img-fluid rounded shadow" alt="@Model.TenPhim" style="max-height: 420px;" onerror="this.src='https://placehold.co/300x450?text=Poster';" />
                <div class="mt-3">
                    @if (Model.TrangThai == "DangChieu")
                    {
                        <span class="badge bg-success fs-6">Đang Chiếu</span>
                    }
                    else if (Model.TrangThai == "SapChieu")
                    {
                        <span class="badge bg-warning text-dark fs-6">Sắp Chiếu</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Ngừng Chiếu</span>
                    }
                </div>
            </div>

            <div class="col-md-8">
                <h2 class="fw-bold text-danger">@Model.TenPhim</h2>
                <div class="mb-3">
                    @foreach (var pt in Model.PhimTheLoais)
                    {
                        <span class="badge bg-primary me-1">@pt.TheLoai?.TenTheLoai</span>
                    }
                </div>

                <p class="lead">@(Model.MoTa ?? "Chưa có mô tả chi tiết.")</p>

                <hr />

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Thời lượng:</div>
                    <div class="col-sm-8 fw-bold">@Model.ThoiLuong phút</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Đạo diễn:</div>
                    <div class="col-sm-8">@(Model.DaoDien ?? "Chưa cập nhật")</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Diễn viên chính:</div>
                    <div class="col-sm-8">@(Model.DienVien ?? "Chưa cập nhật")</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Quốc gia sản xuất:</div>
                    <div class="col-sm-8">@(Model.QuocGia ?? "Chưa cập nhật")</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Ngày khởi chiếu:</div>
                    <div class="col-sm-8">@(Model.NgayKhoiChieu?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-4 text-muted">Trailer URL:</div>
                    <div class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Trailer))
                        {
                            <a href="@Model.Trailer" target="_blank" class="text-danger"><i class="bi bi-youtube"></i> Xem trailer trên YouTube</a>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có link trailer</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            <a asp-action="CapNhat" asp-route-id="@Model.MaPhim" class="btn btn-warning"><i class="bi bi-pencil-square me-1"></i> Chỉnh sửa</a>
        </div>
    </div>
</div>

