@model IEnumerable<GiaoDienQuanTri.Models.Phim>
@{
    ViewData["Title"] = "Quản lý phim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-film text-danger me-2"></i> Quản Lý Kho Phim (Dịch Vụ 2)</h3>
    <a asp-action="Them" class="btn btn-danger"><i class="bi bi-plus-circle me-1"></i> Thêm phim mới</a>
</div>

<!-- Bộ lọc phim -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên phim, đạo diễn..." />
            </div>
            <div class="col-md-4">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="DangChieu" selected="@(ViewBag.TrangThai == "DangChieu")">Đang chiếu (DangChieu)</option>
                    <option value="SapChieu" selected="@(ViewBag.TrangThai == "SapChieu")">Sắp chiếu (SapChieu)</option>
                    <option value="NgungChieu" selected="@(ViewBag.TrangThai == "NgungChieu")">Ngừng chiếu (NgungChieu)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search"></i> Lọc phim</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">Poster</th>
                        <th>Tên Phim</th>
                        <th>Thể Loại</th>
                        <th>Thời Lượng</th>
                        <th>Độ Tuổi</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <img src="/@p.Poster" class="poster-thumb" alt="@p.TenPhim" onerror="this.src='https://placehold.co/45x65?text=Phim';" />
                            </td>
                            <td>
                                <strong>@p.TenPhim</strong>
                                <div class="small text-muted">Đạo diễn: @(p.DaoDien ?? "N/A") | QG: @(p.QuocGia ?? "N/A")</div>
                            </td>
                            <td>
                                @foreach (var pt in p.PhimTheLoais)
                                {
                                    <span class="badge bg-light text-dark border me-1">@pt.TheLoai?.TenTheLoai</span>
                                }
                            </td>
                            <td>@p.ThoiLuong phút</td>
                            <td><span class="badge bg-danger badge-rating">@(p.DoTuoi ?? "P")</span></td>
                            <td>
                                @if (p.TrangThai == "DangChieu")
                                {
                                    <span class="badge bg-success">Đang chiếu</span>
                                }
                                else if (p.TrangThai == "SapChieu")
                                {
                                    <span class="badge bg-warning text-dark">Sắp chiếu</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ngừng chiếu</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ChiTiet" asp-route-id="@p.MaPhim" class="btn btn-sm btn-info text-white me-1" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="CapNhat" asp-route-id="@p.MaPhim" class="btn btn-sm btn-warning me-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <form asp-action="Xoa" asp-route-id="@p.MaPhim" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phim này?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

