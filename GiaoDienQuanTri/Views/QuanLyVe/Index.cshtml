@model IEnumerable<GiaoDienQuanTri.Models.VeDienTu>
@{
    ViewData["Title"] = "Quản lý vé điện tử";
    var tongSoVe = (int)(ViewBag.TongSoVe ?? 0);
    var soChuaSuDung = (int)(ViewBag.SoVeChuaSuDung ?? 0);
    var soDaSuDung = (int)(ViewBag.SoVeDaSuDung ?? 0);
    var soDaHuy = (int)(ViewBag.SoVeDaHuy ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">
        <i class="bi bi-qr-code-scan text-warning me-2"></i> Quản Lý Vé Điện Tử (Dịch Vụ 8)
    </h3>
    <div>
        <a asp-action="SoatVe" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-upc-scan me-1"></i> Mở Quầy Soát Vé / Check-in
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hộp thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tổng Vé Phát Hành</div>
                    <div class="fs-4 fw-bold text-dark">@tongSoVe</div>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                    <i class="bi bi-ticket-perforated fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Vé Chưa Sử Dụng</div>
                    <div class="fs-4 fw-bold text-success">@soChuaSuDung</div>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Vé Đã Soát (Vào Rạp)</div>
                    <div class="fs-4 fw-bold text-info">@soDaSuDung</div>
                </div>
                <div class="rounded-circle bg-info bg-opacity-10 text-info p-3">
                    <i class="bi bi-person-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Vé Đã Hủy</div>
                    <div class="fs-4 fw-bold text-danger">@soDaHuy</div>
                </div>
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3">
                    <i class="bi bi-x-circle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã QR, mã vé, mã đơn, tên phim, khách hàng..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái vé --</option>
                    <option value="ChuaSuDung" selected="@(ViewBag.TrangThai == "ChuaSuDung")">Chưa sử dụng (Hợp lệ)</option>
                    <option value="DaSuDung" selected="@(ViewBag.TrangThai == "DaSuDung")">Đã soát vé (Đã sử dụng)</option>
                    <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Lọc dữ liệu
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách vé điện tử -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Vé</th>
                        <th>Mã QR / Code</th>
                        <th>Khách Hàng</th>
                        <th>Phim & Rạp</th>
                        <th>Suất Chiếu</th>
                        <th>Ghế Ngồi</th>
                        <th>Ngày Phát Hành</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated display-6 d-block mb-2 text-secondary"></i>
                                Không tìm thấy vé điện tử nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var ct = item.ChiTietDatVe;
                        var dv = ct?.DatVe;
                        var suat = dv?.SuatChieu;
                        var phim = suat?.Phim;
                        var phong = suat?.PhongChieu;
                        var rap = phong?.RapChieu;
                        var ghe = ct?.GheSuatChieu?.GheNgoi;

                        <tr>
                            <td class="ps-3 fw-bold">#@item.MaVe</td>
                            <td>
                                <span class="badge bg-light text-dark font-monospace border px-2 py-1">
                                    <i class="bi bi-qr-code me-1 text-primary"></i>@item.MaQR
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(dv?.NguoiDung?.HoTen ?? "Khách vãng lai")</div>
                                <div class="text-muted small">@(dv?.NguoiDung?.Email ?? "")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary">@phim?.TenPhim</div>
                                <div class="text-muted small">@rap?.TenRap • @phong?.TenPhong</div>
                            </td>
                            <td>
                                <div class="small fw-bold">@suat?.NgayChieu.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@suat?.GioBatDau.ToString(@"hh\:mm")</div>
                            </td>
                            <td>
                                <span class="badge bg-dark fs-6 px-2 py-1">@ghe?.HangGhe@ghe?.SoGhe</span>
                                <div class="text-danger fw-bold small">@ct?.DonGia.ToString("N0") đ</div>
                            </td>
                            <td class="small text-muted">
                                @item.NgayPhatHanh.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (item.TrangThai == "ChuaSuDung")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Chưa sử dụng
                                    </span>
                                }
                                else if (item.TrangThai == "DaSuDung")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" title="Sử dụng lúc: @item.NgaySuDung?.ToString("dd/MM/yyyy HH:mm")">
                                        <i class="bi bi-person-check me-1"></i>Đã soát vé
                                    </span>
                                }
                                else if (item.TrangThai == "DaHuy")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i>Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="ChiTiet" asp-route-id="@item.MaVe" class="btn btn-sm btn-outline-primary" title="Xem chi tiết vé">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
